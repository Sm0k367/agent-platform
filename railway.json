{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": [
        {
          "name": "setup",
          "aptPkgs": ["python3", "python3-pip", "python3-venv"]
        }
      ],
      "providers": ["node", "python"]
    }
  },
  "deploy": {
    "startCommand": "npm run dev",
    "restartPolicy": {
      "maxRetries": 10
    }
  }
}
